{
  "name": "@deadrop/cli",
  "version": "0.3.0",
  "description": "Terminal-native client for Deadrop — zero-ceremony one-time secret sharing.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deadrop-dev/cli.git"
  },
  "homepage": "https://deadrop.dev",
  "bugs": "https://github.com/deadrop-dev/cli/issues",
  "keywords": [
    "secrets",
    "secret-sharing",
    "one-time",
    "zero-knowledge",
    "encryption",
    "aes-256-gcm",
    "cli"
  ],
  "bin": {
    "deadrop": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit && tsup"
  },
  "dependencies": {
    "@deadrop/crypto": "^0.3.0",
    "commander": "^12.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
